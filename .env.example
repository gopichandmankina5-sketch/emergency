# MongoDB Atlas Connection String Example
# Syntax: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB Syntax: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Database Name (Default: corridor_db)
MONGODB_DATABASE=corridor_db
DB_NAME=corridor_db

# Push Notification / FCM Configuration
FCM_SIMULATION=false
FIREBASE_CREDENTIALS_PATH=backend/firebase-service-account.json

# GPS Stale Timeout
GPS_STALE_TIMEOUT_SECONDS=60.0
